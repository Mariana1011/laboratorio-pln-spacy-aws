[Unit]
Description=API PLN Flask con Gunicorn
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/environment
Environment="PATH=/home/ec2-user/environment/venv/bin"
ExecStart=/home/ec2-user/environment/venv/bin/gunicorn -w 2 -b 0.0.0.0:8080 app:app
Restart=always

[Install]
WantedBy=multi-user.target
